{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deal",
  "type": "object",
  "properties": {
    "capital": {
      "$ref": "#/$defs/Capital"
    },
    "debt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Debt"
        },
        {
          "type": "null"
        }
      ]
    },
    "equity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Equity"
        },
        {
          "type": "null"
        }
      ]
    },
    "exit": {
      "$ref": "#/$defs/Exit"
    },
    "market": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarketProfile"
      }
    },
    "opex": {
      "$ref": "#/$defs/Opex",
      "default": {
        "lines": [],
        "management_fee_pct": 0.0
      }
    },
    "other_income": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IncomeLine"
      }
    },
    "property": {
      "$ref": "#/$defs/Property"
    },
    "recoveries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Recovery"
      }
    },
    "rent_roll": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Lease"
      }
    },
    "revenue": {
      "$ref": "#/$defs/Revenue",
      "default": {
        "credit_loss_pct": 0.0,
        "general_vacancy_pct": 0.0,
        "vacancy_on_top_of_downtime": false
      }
    },
    "unit_mix": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UnitType"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "property",
    "capital",
    "exit"
  ],
  "$defs": {
    "CapexItem": {
      "type": "object",
      "properties": {
        "amount": {
          "description": "Dollars.",
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "month": {
          "description": "Model month (1 = first month).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "month",
        "amount"
      ]
    },
    "Capital": {
      "type": "object",
      "properties": {
        "capex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapexItem"
          }
        },
        "closing_costs": {
          "description": "Closing costs in dollars.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "price": {
          "description": "Purchase price in dollars.",
          "type": "number",
          "format": "double"
        },
        "reserves_per_sf_yr": {
          "description": "Capital reserves in $/SF/yr (office, retail, industrial).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "reserves_per_unit_yr": {
          "description": "Capital reserves in $/unit/yr (multifamily).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "price"
      ]
    },
    "Compounding": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "monthly",
            "quarterly",
            "annual"
          ]
        },
        {
          "description": "Cumulative, non-compounding.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "CurvePoint": {
      "type": "object",
      "properties": {
        "index": {
          "description": "Annual index rate as a decimal.",
          "type": "number",
          "format": "double"
        },
        "month": {
          "description": "Model month from which this index applies.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "month",
        "index"
      ]
    },
    "Date": {
      "description": "A calendar date, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Debt": {
      "type": "object",
      "properties": {
        "amortization_years": {
          "description": "Omitted = interest only for the whole hold.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "amount": {
          "description": "A fixed loan amount; otherwise `sizing` applies.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "io_months": {
          "description": "Interest-only months from close.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "origination_fee_pct": {
          "description": "Fee at close as a share of the loan.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "prepayment_penalty_pct": {
          "description": "Share of the payoff balance; a list gives it by loan year (last repeats).",
          "anyOf": [
            {
              "$ref": "#/$defs/PctSchedule"
            },
            {
              "type": "null"
            }
          ]
        },
        "rate": {
          "$ref": "#/$defs/Rate"
        },
        "sizing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sizing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "rate"
      ]
    },
    "Equity": {
      "type": "object",
      "properties": {
        "contributions": {
          "description": "LP and GP shares of contributions.",
          "$ref": "#/$defs/Shares"
        },
        "tiers": {
          "description": "Applied in order to every distribution; the last takes what is left.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tier"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "contributions",
        "tiers"
      ]
    },
    "Exit": {
      "type": "object",
      "properties": {
        "cap_rate": {
          "description": "Applied to forward 12-month NOI.",
          "type": "number",
          "format": "double"
        },
        "month": {
          "description": "Sale month; default the hold period.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "selling_costs_pct": {
          "description": "Share of gross sale.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "additionalProperties": false,
      "required": [
        "cap_rate"
      ]
    },
    "ExpenseLine": {
      "type": "object",
      "properties": {
        "amount_yr": {
          "description": "Dollars per year at the analysis start.",
          "type": "number",
          "format": "double"
        },
        "controllable": {
          "description": "Subject to a lease's controllable-expense cap.",
          "type": "boolean",
          "default": false
        },
        "growth": {
          "description": "Annual growth as a decimal.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "recoverable": {
          "description": "Included in the pool tenants reimburse.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "amount_yr",
        "recoverable"
      ]
    },
    "Floating": {
      "description": "Index + spread, annual decimals; the curve is a step function.",
      "type": "object",
      "properties": {
        "curve": {
          "description": "Index by model month; the first point is month 1.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurvePoint"
          }
        },
        "spread": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "spread",
        "curve"
      ]
    },
    "Hurdle": {
      "oneOf": [
        {
          "description": "Until the LP reaches this annual IRR.",
          "type": "object",
          "properties": {
            "compounding": {
              "$ref": "#/$defs/Compounding",
              "default": "annual"
            },
            "rate": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "irr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "rate"
          ]
        },
        {
          "description": "Until LP distributions reach this multiple of LP contributions.",
          "type": "object",
          "properties": {
            "multiple": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "multiple"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "multiple"
          ]
        }
      ]
    },
    "IncomeLine": {
      "type": "object",
      "properties": {
        "amount_yr": {
          "description": "Dollars per year at the analysis start.",
          "type": "number",
          "format": "double"
        },
        "growth": {
          "description": "Annual growth as a decimal.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "amount_yr"
      ]
    },
    "Lease": {
      "description": "One lease on the rent roll.",
      "type": "object",
      "properties": {
        "expiry": {
          "description": "Last day in effect.",
          "$ref": "#/$defs/Date"
        },
        "free_rent_months": {
          "description": "Months of base rent abated from the lease start.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "id": {
          "description": "Unique lease id.",
          "type": "string"
        },
        "market": {
          "description": "Per-lease overrides of the market profile.",
          "anyOf": [
            {
              "$ref": "#/$defs/MarketOverride"
            },
            {
              "type": "null"
            }
          ]
        },
        "pro_rata_share": {
          "description": "Override of sf / rentable_sf.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "recovery": {
          "description": "A name from `recoveries`, or an inline structure. Default: `recoveries.default`.",
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "rent_psf_yr": {
          "description": "Base rent in $/SF/yr in effect on the start date (lease year 1).",
          "type": "number",
          "format": "double"
        },
        "security_deposit": {
          "description": "Dollars held; reported only, no cash-flow effect.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "sf": {
          "description": "Leased area in square feet.",
          "type": "number",
          "format": "double"
        },
        "space_type": {
          "description": "Market profile id used when the lease expires.",
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "description": "First day in effect.",
          "$ref": "#/$defs/Date"
        },
        "steps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Steps"
            },
            {
              "type": "null"
            }
          ]
        },
        "suite": {
          "type": "string"
        },
        "tenant": {
          "description": "Tenant name.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "tenant",
        "sf",
        "start",
        "expiry",
        "rent_psf_yr"
      ]
    },
    "LeasingTerms": {
      "type": "object",
      "properties": {
        "free_rent_months": {
          "description": "Months of free base rent.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "lc_pct": {
          "description": "Leasing commission as a share of base rent over the term (free months excluded).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "ti_psf": {
          "description": "Tenant improvements in $/SF, paid when the lease starts.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "additionalProperties": false
    },
    "MarketOverride": {
      "type": "object",
      "properties": {
        "downtime_months": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "market_rent_psf_yr": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeasingTerms"
            },
            {
              "type": "null"
            }
          ]
        },
        "renewal": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeasingTerms"
            },
            {
              "type": "null"
            }
          ]
        },
        "renewal_probability": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rent_growth": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "term_months": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "MarketProfile": {
      "description": "Market leasing assumptions for one space type.",
      "type": "object",
      "properties": {
        "downtime_months": {
          "description": "Months vacant before a new tenant.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "description": "Space type id referenced by leases.",
          "type": "string"
        },
        "market_rent_psf_yr": {
          "description": "Market rent in $/SF/yr at the analysis start.",
          "type": "number",
          "format": "double"
        },
        "new": {
          "description": "Terms for a new tenant.",
          "$ref": "#/$defs/LeasingTerms"
        },
        "renewal": {
          "description": "Terms for a renewing tenant.",
          "$ref": "#/$defs/LeasingTerms"
        },
        "renewal_probability": {
          "description": "Probability (0 to 1) that an expiring tenant renews.",
          "type": "number",
          "format": "double"
        },
        "rent_growth": {
          "description": "Annual market rent growth as a decimal, compounding each analysis year.",
          "type": "number",
          "format": "double"
        },
        "term_months": {
          "description": "Term of a speculative lease in months.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "market_rent_psf_yr",
        "rent_growth",
        "renewal_probability",
        "downtime_months",
        "term_months",
        "new",
        "renewal"
      ]
    },
    "Opex": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ExpenseLine"
          }
        },
        "management_fee_pct": {
          "description": "Share of EGI.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "additionalProperties": false
    },
    "PctSchedule": {
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      ]
    },
    "Property": {
      "type": "object",
      "properties": {
        "hold_months": {
          "description": "Hold period in months.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "rentable_sf": {
          "description": "Rentable square feet (office, retail, industrial).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "start_date": {
          "description": "Analysis start: the first day of a month. Acquisition closes on it.",
          "$ref": "#/$defs/Date"
        },
        "type": {
          "description": "office, retail, industrial or multifamily.",
          "$ref": "#/$defs/PropertyType"
        },
        "units": {
          "description": "Unit count (multifamily); must equal the unit mix total.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "start_date",
        "hold_months"
      ]
    },
    "PropertyType": {
      "type": "string",
      "enum": [
        "office",
        "retail",
        "industrial",
        "multifamily"
      ]
    },
    "Rate": {
      "description": "Give exactly one of `fixed` or `floating`.",
      "type": "object",
      "properties": {
        "fixed": {
          "description": "Annual fixed rate as a decimal.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "floating": {
          "anyOf": [
            {
              "$ref": "#/$defs/Floating"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Recovery": {
      "description": "How a tenant reimburses operating expenses.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cap_controllable_pct": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "nnn"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cap_controllable_pct": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "base_year"
            },
            "year": {
              "type": "integer",
              "format": "int32"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "year"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cap_controllable_pct": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "stop_psf_yr": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "expense_stop"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "stop_psf_yr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cap_controllable_pct": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "modified_gross"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "lines"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gross"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "RecoveryRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Recovery"
        }
      ]
    },
    "Revenue": {
      "type": "object",
      "properties": {
        "credit_loss_pct": {
          "description": "Share of PGR.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "general_vacancy_pct": {
          "description": "Share of PGR.",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "vacancy_on_top_of_downtime": {
          "description": "true: general vacancy is not reduced by modeled downtime.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Shares": {
      "type": "object",
      "properties": {
        "gp": {
          "type": "number",
          "format": "double"
        },
        "lp": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "lp",
        "gp"
      ]
    },
    "Sizing": {
      "type": "object",
      "properties": {
        "max_ltv": {
          "description": "Maximum loan / price.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min_debt_yield": {
          "description": "Minimum year-1 NOI / loan.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min_dscr": {
          "description": "Minimum year-1 NOI / annual debt service.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Split": {
      "anyOf": [
        {
          "description": "`pro_rata`: by contributions.",
          "type": "string"
        },
        {
          "$ref": "#/$defs/Shares"
        }
      ]
    },
    "Steps": {
      "description": "Rent steps on each lease anniversary.",
      "oneOf": [
        {
          "description": "`rate` per year, compounding.",
          "type": "object",
          "properties": {
            "rate": {
              "description": "Annual increase as a decimal.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "percent"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "rate"
          ]
        },
        {
          "description": "A fixed $/SF/yr increase per year.",
          "type": "object",
          "properties": {
            "amount_psf_yr": {
              "description": "$/SF/yr added each lease year.",
              "type": "number",
              "format": "double"
            },
            "type": {
